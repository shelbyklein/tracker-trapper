{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "TT_EVENT_MESSAGE='Claude tool activity' TT_TRACKER_TRAPPER_BIN=/absolute/path/to/.build/arm64-apple-macosx/debug/tracker-trapper TT_RUN_ID=run-id /absolute/path/to/Integrations/report-event.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TT_EVENT_MESSAGE='Claude turn stopped' TT_TRACKER_TRAPPER_BIN=/absolute/path/to/.build/arm64-apple-macosx/debug/tracker-trapper TT_RUN_ID=run-id /absolute/path/to/Integrations/report-event.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
